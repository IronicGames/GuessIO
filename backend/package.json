  "scripts": {
    "dev": "tsx watch src/server.ts",
    "debug": "tsx watch --inspect src/server.ts",
    "build": "tsc",
    "start:all": "npm run docker:up && npm run dev",
    "start:all:debug": "npm run docker:up && npm run debug",
    "docker:up": "cd .. && docker-compose up -d",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:fullreset": "npm run db:reset && npm run db:migrate && npm run db:generate"
  },
